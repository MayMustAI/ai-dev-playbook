{
  "description": "MayMust 공통 작업 지침 및 보호 브랜치 가드",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "exec_command|shell_command|unified_exec|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/branch-guard.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/session-start.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
