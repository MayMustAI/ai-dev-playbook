{
  "description": "MayMust 팀 가드 — dev · main 에 직접 git commit 시 사용자 확인 요청",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/branch-guard.sh\""
          }
        ]
      }
    ]
  }
}
